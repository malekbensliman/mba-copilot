# AUTH_SECRET: random server-side key that signs your login session so it
# can't be forged. Generate one at https://generate-secret.vercel.app/32
# (any value works — pick one and keep it; you never type it to log in).
AUTH_SECRET=your-random-secret-here

# AUTH_PASSWORD: the password you'll type to sign into the app.
# Share it with anyone you want to give access (classmates, study group).
AUTH_PASSWORD=your-secure-password-here

# OpenAI: set both OPENAI_API_KEY and OPENAI_BASE_URL.

# Option 1: Columbia Business School's OpenAI endpoint (recommended for students)
# Get your key at https://cbsai.business.columbia.edu
OPENAI_API_KEY=your-instructor-provided-key
OPENAI_BASE_URL=https://cbsai.business.columbia.edu/api/v1

# Option 2: Your own OpenAI account (uncomment these and comment out Option 1 above)
# OPENAI_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# Pinecone: your API key + the index name (must match the index you created)
PINECONE_API_KEY=xxxxxxxxxxxx
PINECONE_INDEX=mba-copilot
